{
  "project_root": "",
  "export_dir": "",
  "import_dir": "",
  "state_file": "",
  "max_batch_kb": 45,
  "scan": {
    "mode": "whitelist",
    "extensions": [
      "py",
      "pyi",
      "pyx",
      "js",
      "mjs",
      "cjs",
      "jsx",
      "ts",
      "tsx",
      "vue",
      "svelte",
      "java",
      "kt",
      "kts",
      "scala",
      "groovy",
      "go",
      "rs",
      "rb",
      "php",
      "cs",
      "fs",
      "c",
      "h",
      "cc",
      "cpp",
      "cxx",
      "hpp",
      "hh",
      "m",
      "mm",
      "swift",
      "dart",
      "sh",
      "bash",
      "zsh",
      "ps1",
      "psm1",
      "bat",
      "cmd",
      "sql",
      "prisma",
      "graphql",
      "gql",
      "proto",
      "thrift",
      "html",
      "htm",
      "css",
      "scss",
      "sass",
      "less",
      "styl",
      "json",
      "jsonc",
      "toml",
      "ini",
      "cfg",
      "conf",
      "properties",
      "xml",
      "xsd",
      "gradle",
      "sbt",
      "cmake",
      "mk",
      "make",
      "md",
      "mdx",
      "rst",
      "txt",
      "tf",
      "tfvars",
      "hcl",
      "lua",
      "pl",
      "pm",
      "r",
      "jl",
      "ex",
      "exs",
      "erl",
      "clj",
      "cljs",
      "elm",
      "nim",
      "zig",
      "asm",
      "tpl",
      "hbs",
      "ejs",
      "pug",
      "twig",
      "razor",
      "cshtml",
      "jinja",
      "j2",
      "jsp",
      "jspx",
      "tag",
      "tld",
      "ftl",
      "mustache",
      "bzl",
      "bazel",
      "aidl"
    ],
    "filenames": [
      "Dockerfile",
      "Makefile",
      "Rakefile",
      "Gemfile",
      "Procfile",
      "Justfile",
      "CMakeLists.txt",
      ".gitignore",
      ".dockerignore",
      ".editorconfig",
      ".eslintrc",
      ".prettierrc",
      ".babelrc",
      "LICENSE",
      "README",
      "mvnw",
      "gradlew",
      "BUILD",
      "WORKSPACE"
    ],
    "exclude_dirs": [
      ".git",
      ".svn",
      ".hg",
      ".idea",
      ".vscode",
      ".vs",
      "node_modules",
      "bower_components",
      "vendor",
      "jspm_packages",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      ".tox",
      "venv",
      ".venv",
      "env",
      ".env.d",
      "virtualenv",
      "site-packages",
      "dist",
      "build",
      "out",
      "target",
      "bin",
      "obj",
      ".next",
      ".nuxt",
      ".svelte-kit",
      "coverage",
      "htmlcov",
      ".gradle",
      ".terraform",
      ".serverless",
      ".cache",
      ".parcel-cache",
      ".turbo",
      "logs",
      "tmp",
      "temp",
      ".codeshuttle",
      ".codeshuttle_backup"
    ],
    "exclude_globs": [
      "*.min.js",
      "*.min.css",
      "*.map",
      "*.lock",
      "*-lock.json",
      "*.log",
      "*.pyc",
      "*.pyo",
      "*.class",
      "*.o",
      "*.so",
      "*.dll",
      "*.exe",
      "*.bin",
      "*.zip",
      "*.gz",
      "*.tar",
      "*.7z",
      "*.rar",
      "*.jar",
      "*.war",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.svg",
      "*.webp",
      "*.pdf",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot",
      "*.mp4",
      "*.mp3",
      "*.wav",
      "*.db",
      "*.sqlite",
      "*.sqlite3",
      "*.mdb",
      "*.yml",
      "*.yaml"
    ],
    "max_file_kb": 512,
    "follow_symlinks": false
  },
  "security": {
    "enabled": true,
    "secret_filename_globs": [
      ".env",
      ".env.*",
      "*.env",
      "env.local",
      "*.pem",
      "*.key",
      "*.pfx",
      "*.p12",
      "*.jks",
      "*.keystore",
      "*.crt",
      "*.cer",
      "*.der",
      "*.ppk",
      "*.kdbx",
      "*.ovpn",
      "id_rsa*",
      "id_dsa*",
      "id_ecdsa*",
      "id_ed25519*",
      "*.asc",
      "*.gpg",
      ".netrc",
      "_netrc",
      ".npmrc",
      ".pypirc",
      ".htpasswd",
      ".dockercfg",
      "credentials",
      "credentials.*",
      "*credentials*",
      "*secret*",
      "*secrets*",
      "*service-account*.json",
      "*serviceaccount*.json",
      "*.pfx.json",
      ".aws/*",
      ".ssh/*",
      "*/.aws/*",
      "*/.ssh/*"
    ],
    "redact_patterns": true,
    "drop_file_on_critical": true,
    "max_redactions_per_file": 40,
    "redact_high_entropy": true,
    "high_entropy_min_len": 40,
    "redact_emails": false,
    "redact_ips": false,
    "extra_patterns": []
  },
  "import": {
    "apply_deletes": true,
    "move_applied": true,
    "prune_extra_on_full": false,
    "require_all_batches": false
  }
}
